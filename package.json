{
  "name": "react-native-inspector-app",
  "version": "1.0.0",
  "description": "React Native Inspector Pro — internal process runner + log inspector",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "pack": "electron-builder --dir",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "react-native",
    "debugger",
    "inspector",
    "electron"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "dependencies": {
    "ws": "^8.21.2"
  },
  "build": {
    "appId": "com.rn-inspector.app",
    "productName": "React Native Inspector",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "**/*",
      "!release/**"
    ],
    "win": {
      "target": [
        "nsis",
        "appx"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}